# このファイルを .env にコピーして値を設定する
#   cp .env.example .env
#
# ローカル Supabase (`pnpm supabase start`) を使う場合は、
# 起動時に表示される API URL / anon key を設定する。
# 共有の Supabase プロジェクトを使う場合は、ダッシュボードの
# Project Settings > API の値を設定する。
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# macOS / Windows でホットリロードが効かない場合は true にする
VITE_USE_POLLING=false

# scripts/seed-themes.mjs（小テーマの投入）用。ブラウザには公開されないサーバー/CLI 専用の鍵。
# ローカル Supabase の Secret key（`sb_secret_...`）を設定する。値は全員同じ固定値で、
# `npx supabase status` の出力（Secret の行）で確認できる。
# 本番の鍵はここには書かない（本番投入は GitHub Actions が Secrets から行う）。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
