# このファイルを .env にコピーして値を設定する
#   cp .env.example .env
#
# ローカル Supabase (`pnpm supabase start`) を使う場合は、
# 起動時に表示される API URL / anon key を設定する。
# 共有の Supabase プロジェクトを使う場合は、ダッシュボードの
# Project Settings > API の値を設定する。
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# macOS / Windows でホットリロードが効かない場合は true にする
VITE_USE_POLLING=false
