# このファイルを .env にコピーして値を設定する
#   cp .env.example .env
#
# ローカル Supabase (`pnpm supabase start`) を使う場合は、
# 起動時に表示される API URL / anon key を設定する。
# 共有の Supabase プロジェクトを使う場合は、ダッシュボードの
# Project Settings > API の値を設定する。
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# macOS / Windows でホットリロードが効かない場合は true にする
VITE_USE_POLLING=false

# scripts/seed-topics.mjs（話題データの投入）用。ブラウザには公開されないサーバー/CLI 専用の鍵。
# ローカル Supabase なら `supabase start` 実行時に表示される service_role key。
# 本番へ投入する場合はコマンド実行時に環境変数で渡す（このファイル/.env には本番の鍵を書かない）。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
